{
  "name": "shipkit-typecheck",
  "private": true,
  "description": "Compiles every ShipKit registry component against app shims, and runs unit tests for the pure helpers.",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --no-warnings --import ./tests/setup.mjs --test \"tests/*.test.ts\""
  },
  "devDependencies": {
    "@tanstack/react-table": "^8.20.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@upstash/ratelimit": "^2.0.0",
    "@upstash/redis": "^1.34.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "typescript": "^5.6.0"
  }
}